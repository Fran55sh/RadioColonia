# Database (solo desarrollo local con docker-compose: Postgres mapeado al host en 5433).
# En Coolify / VPS / producción: NO uses 127.0.0.1 ni :5433. Dentro del contenedor web,
# 127.0.0.1 es el propio contenedor → ECONNREFUSED. Usá el hostname interno que te da
# Coolify para Postgres, puerto 5432, usuario/clave/db reales. Ejemplo genérico:
# DATABASE_URL="postgresql://USER:PASS@nombre-servicio-postgres:5432/NOMBRE_DB"
DATABASE_URL="postgresql://radiocolonia:radiocolonia_secret@127.0.0.1:5433/radiocolonia_db"

# Auth.js v5
AUTH_SECRET="your-super-secret-auth-key-change-in-production"
AUTH_URL="http://localhost:3000"

# Mercado Pago
MP_ACCESS_TOKEN="TEST-your-mercadopago-access-token"
MP_WEBHOOK_SECRET="your-mp-webhook-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin seed credentials
ADMIN_EMAIL="admin@radiocolonia.local"
ADMIN_PASSWORD="Admin1234!"
