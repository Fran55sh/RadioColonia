# Database: usar 127.0.0.1 evita ECONNREFUSED si "localhost" resuelve a IPv6.
# Esperá a que el contenedor esté "healthy" antes de db:push (docker compose up -d --wait).
DATABASE_URL="postgresql://radiocolonia:radiocolonia_secret@127.0.0.1:5433/radiocolonia_db"

# Auth.js v5
AUTH_SECRET="your-super-secret-auth-key-change-in-production"
AUTH_URL="http://localhost:3000"

# Mercado Pago
MP_ACCESS_TOKEN="TEST-your-mercadopago-access-token"
MP_WEBHOOK_SECRET="your-mp-webhook-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin seed credentials
ADMIN_EMAIL="admin@radiocolonia.local"
ADMIN_PASSWORD="Admin1234!"
