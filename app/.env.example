# Base de datos: variables explícitas (la app arma la URL en código; no uses DATABASE_URL).
# En Docker Compose / Coolify, definí DB_HOST al hostname o IP que el runtime debe usar (lo inyecta el compose).
# En dev local con postgres del repo en el puerto host 5433: DB_HOST=127.0.0.1, DB_PORT=5433
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=radiocolonia
DB_PASSWORD=radiocolonia_secret
DB_NAME=radiocolonia_db

# Auth.js v5
AUTH_SECRET="your-super-secret-auth-key-change-in-production"
AUTH_URL="http://localhost:3000"

# Mercado Pago
MP_ACCESS_TOKEN="TEST-your-mercadopago-access-token"
MP_WEBHOOK_SECRET="your-mp-webhook-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin seed credentials
ADMIN_EMAIL="admin@radiocolonia.local"
ADMIN_PASSWORD="Admin1234!"
